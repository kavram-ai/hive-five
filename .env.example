# GLM-4.6 API Configuration
GLM_API_KEY=your-api-key-here
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MESSAGES=agent.messages
KAFKA_TOPIC_ACTIONS=agent.actions
KAFKA_TOPIC_INTERNAL=agent.internal
KAFKA_TOPIC_CONTROL=system.control
KAFKA_CONSUMER_GROUP=agent-system

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hive_five
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
AGENT_RESPONSE_TIMEOUT=30
MAX_CONTEXT_EVENTS=10

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
